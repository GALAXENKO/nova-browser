<Window x:Class="NovaBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NovaBrowser.Models"
        mc:Ignorable="d"
        Title="Nova Browser"
        Width="1320" Height="820" MinWidth="880" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        LocationChanged="Window_LocationChanged"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BookmarkBarButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SmallTextButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="9,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SuggestionItemStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="54" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Вкладки и заголовок окна -->
        <Grid Grid.Row="0" Background="{DynamicResource TabStripBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="TabsScroll" Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                          PreviewMouseWheel="TabsScroll_PreviewMouseWheel">
                <ItemsControl x:Name="TabsItems" ItemsSource="{Binding Tabs}" Margin="8,6,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BrowserTab}">
                            <Border x:Name="TabBorder" Height="36" MinWidth="128" MaxWidth="252" Margin="0,0,4,0"
                                    CornerRadius="9,9,0,0" Background="Transparent"
                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                    MouseDown="Tab_MouseDown"
                                    ToolTip="{Binding Url}">
                                <Grid Margin="10,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="19" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="17" Height="17" VerticalAlignment="Center">
                                        <Border x:Name="FaviconFallback" Width="17" Height="17" CornerRadius="5"
                                                Background="{Binding AccentBrush}" Visibility="Collapsed">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="9.5"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image x:Name="FaviconImage" Source="{Binding Favicon}" Width="16" Height="16"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>

                                    <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}" Margin="7,0,3,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />

                                    <Button Grid.Column="2" Tag="{Binding}" Click="CloseTab_Click"
                                            Style="{StaticResource SmallIconButtonStyle}" Width="22" Height="22"
                                            FontSize="9" Content="&#xE8BB;" ToolTip="Закрыть вкладку" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                    <Setter TargetName="FaviconFallback" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="FaviconImage" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button x:Name="NewTabButton" Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}"
                    Width="30" Height="30" Margin="3,6,7,6" FontSize="14" Content="&#xE710;"
                    Click="NewTab_Click" ToolTip="Новая вкладка (Ctrl+T)" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Свернуть" />
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Развернуть" />
                <Button Style="{StaticResource CloseWindowButtonStyle}" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="Закрыть" />
            </StackPanel>
        </Grid>

        <!-- Панель навигации -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Margin="10,9,12,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource ToolbarButtonStyle}"
                            Content="&#xE72B;" Click="Back_Click" ToolTip="Назад (Alt+←)" IsEnabled="False" />
                    <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}"
                            Content="&#xE72A;" Click="Forward_Click" ToolTip="Вперёд (Alt+→)" IsEnabled="False" />
                    <Button x:Name="ReloadButton" Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}"
                            Content="&#xE72C;" Click="Reload_Click" ToolTip="Обновить (F5)" />
                    <Button x:Name="HomeButton" Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}"
                            Content="&#xE80F;" Click="Home_Click" ToolTip="Домашняя страница"
                            AutomationProperties.Name="Домашняя страница" />

                    <Border x:Name="AddressBorder" Grid.Column="4" Height="36" Margin="8,0,10,0"
                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid Margin="9,0,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SecurityIcon" Grid.Column="0" Text="&#xE72E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                       Margin="0,0,5,0" ToolTip="Сведения о сайте" />

                            <Grid Grid.Column="1">
                                <TextBox x:Name="AddressBar" Style="{StaticResource AddressTextBoxStyle}"
                                         VerticalAlignment="Center"
                                         KeyDown="AddressBar_KeyDown"
                                         PreviewKeyDown="AddressBar_PreviewKeyDown"
                                         TextChanged="AddressBar_TextChanged"
                                         GotKeyboardFocus="AddressBar_GotKeyboardFocus"
                                         LostKeyboardFocus="AddressBar_LostKeyboardFocus" />
                                <TextBlock x:Name="AddressPlaceholder" Text="Введите адрес или поисковый запрос"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13.5"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>

                            <Button x:Name="ClearAddressButton" Grid.Column="2" Style="{StaticResource SmallIconButtonStyle}"
                                    Width="23" Height="23" FontSize="8" Content="&#xE711;"
                                    Click="ClearAddress_Click" ToolTip="Очистить" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border x:Name="PrivateBadge" Grid.Column="5" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12"
                            Padding="9,4" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="История и cookies этого окна не сохраняются">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE727;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Приватно" Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                       FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="BookmarkButton" Grid.Column="6" Style="{StaticResource ToolbarButtonStyle}"
                            Content="&#xE734;" Click="ToggleBookmark_Click" ToolTip="Добавить закладку (Ctrl+D)" />
                    <Button x:Name="DownloadsButton" Grid.Column="7" Style="{StaticResource ToolbarButtonStyle}"
                            Content="&#xE896;" Click="Downloads_Click" ToolTip="Загрузки (Ctrl+J)" />
                    <Button x:Name="MenuButton" Grid.Column="8" Style="{StaticResource ToolbarButtonStyle}"
                            Content="&#xE712;" Click="Menu_Click" ToolTip="Настройки и другое" />
                </Grid>

                <ProgressBar x:Name="LoadProgress" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True"
                             Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                             Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Панель закладок -->
        <Border x:Name="BookmarksBar" Grid.Row="2" Height="34" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <ItemsControl ItemsSource="{Binding Bookmarks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Bookmark}">
                                    <Button Style="{StaticResource BookmarkBarButtonStyle}" Tag="{Binding}"
                                            Click="BookmarkBar_Click" ToolTip="{Binding Url}" Margin="0,0,2,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource AccentSoftBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Margin="6,0,0,0" MaxWidth="160"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource BookmarkBarButtonStyle}" Width="28" Padding="0"
                                Content="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                Click="AddCurrentBookmark_Click" ToolTip="Добавить текущую страницу в закладки" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Содержимое -->
        <Grid x:Name="ContentHost" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
            <Grid x:Name="WebViewLayer" />

            <Grid x:Name="StartupOverlay" Background="{DynamicResource AppBackgroundBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="74" Height="74" CornerRadius="22" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4E6BFF" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="N" Foreground="White" FontSize="38" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Nova Browser" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Загружаем Chromium…" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Подсказки адресной строки -->
        <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=AddressBorder}" Placement="Bottom"
               VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Width="{Binding ActualWidth, ElementName=AddressBorder}">
            <Border Style="{StaticResource PanelCardStyle}" Margin="10" Padding="6">
                <ListBox x:Name="SuggestionsList" Style="{StaticResource SuggestionListStyle}" MaxHeight="330"
                         PreviewMouseLeftButtonUp="SuggestionsList_PreviewMouseLeftButtonUp"
                         KeyDown="SuggestionsList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- Меню браузера -->
        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom"
               HorizontalOffset="-292" VerticalOffset="7" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PanelCardStyle}" Width="330" Margin="12" Padding="6">
                <StackPanel>
                    <Button Style="{StaticResource MenuButtonStyle}" Click="NewTab_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Новая вкладка" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+T" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Click="NewWindow_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE737;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Новое окно" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+N" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Click="NewPrivateWindow_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE727;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Новое приватное окно" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+Shift+N" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource DividerStyle}" />

                    <Button Style="{StaticResource MenuButtonStyle}" Click="History_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="История" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+H" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Click="Bookmarks_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Закладки" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+Shift+O" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Click="Downloads_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Загрузки" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+J" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource DividerStyle}" />

                    <Button Style="{StaticResource MenuButtonStyle}" Click="Find_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Найти на странице" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Grid Height="40" Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8A3;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Grid.Column="1" Text="Масштаб" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE738;" Click="ZoomOut_Click" ToolTip="Уменьшить" />
                            <TextBlock x:Name="ZoomText" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                            <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE710;" Click="ZoomIn_Click" ToolTip="Увеличить" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource DividerStyle}" />

                    <Button Style="{StaticResource MenuButtonStyle}" Click="Settings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Настройки" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Alt+E" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Click="About_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="О браузере" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource DividerStyle}" />
                    <Button Style="{StaticResource MenuButtonStyle}" Click="Exit_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Выход" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Alt+F4" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Загрузки -->
        <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}" Placement="Bottom"
               HorizontalOffset="-384" VerticalOffset="7" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PanelCardStyle}" Width="420" MaxHeight="600" Margin="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,14,12,8">
                        <TextBlock Text="Загрузки" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Style="{StaticResource PanelCloseButtonStyle}" HorizontalAlignment="Right"
                                Content="&#xE8BB;" Click="ClosePopups_Click" />
                    </Grid>

                    <Grid Grid.Row="1" MinHeight="160">
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DownloadsItems" ItemsSource="{Binding Downloads}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:DownloadItem}">
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0" />
                                                </Grid>
                                                <ProgressBar Height="4" Margin="0,7,0,5" Value="{Binding Progress}" Maximum="100"
                                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceSunkenBrush}" BorderThickness="0" />
                                                <Grid>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource SmallTextButtonStyle}" Content="Открыть" Tag="{Binding}"
                                                                Click="OpenDownload_Click" Margin="0,0,5,0"
                                                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Style="{StaticResource SmallTextButtonStyle}" Content="Папка" Tag="{Binding}" Click="ShowDownloadFolder_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="DownloadsEmpty" Text="Здесь появятся загруженные файлы"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="16,10,16,14">
                        <Button Style="{StaticResource SmallTextButtonStyle}" Content="Открыть папку загрузок"
                                HorizontalAlignment="Left" Click="OpenDownloadsFolder_Click" />
                        <Button Style="{StaticResource SmallTextButtonStyle}" Content="Очистить" HorizontalAlignment="Right"
                                Click="ClearDownloads_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <!-- История -->
        <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom"
               HorizontalOffset="-398" VerticalOffset="7" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PanelCardStyle}" Width="430" MaxHeight="620" Margin="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="18,14,12,8">
                        <TextBlock Text="История" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SmallTextButtonStyle}" Content="Очистить" Click="ClearHistory_Click" Margin="0,0,4,0" />
                            <Button Style="{StaticResource PanelCloseButtonStyle}" Content="&#xE8BB;" Click="ClosePopups_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="160">
                        <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="HistoryItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HistoryEntry}">
                                        <Button Style="{StaticResource MenuButtonStyle}" Tag="{Binding}" Click="HistoryItem_Click" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="7,0,8,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Host}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="HistoryEmpty" Text="История пока пуста" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Последние посещения сохраняются локально" FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="18,8,18,14" />
                </Grid>
            </Border>
        </Popup>

        <!-- Закладки -->
        <Popup x:Name="BookmarksPopup" PlacementTarget="{Binding ElementName=BookmarkButton}" Placement="Bottom"
               HorizontalOffset="-354" VerticalOffset="7" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PanelCardStyle}" Width="390" MaxHeight="600" Margin="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="18,14,12,8">
                        <TextBlock Text="Закладки" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Style="{StaticResource PanelCloseButtonStyle}" HorizontalAlignment="Right"
                                Content="&#xE8BB;" Click="ClosePopups_Click" />
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="140">
                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Bookmark}">
                                        <Grid Margin="0,1">
                                            <Button Style="{StaticResource MenuButtonStyle}" Tag="{Binding}" Click="BookmarkItem_Click" Padding="10,7,38,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Host}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource SmallIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="0,0,8,0" Content="&#xE74D;" Tag="{Binding}" Click="DeleteBookmark_Click" ToolTip="Удалить закладку" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="BookmarksEmpty" Text="Закладок пока нет" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                    <Button Grid.Row="2" Style="{StaticResource SmallTextButtonStyle}" Margin="16,10,16,14"
                            Content="Добавить текущую страницу" Click="AddCurrentBookmark_Click" HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Popup>

        <!-- Поиск на странице -->
        <Popup x:Name="FindPopup" PlacementTarget="{Binding ElementName=ContentHost}" Placement="Relative"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PanelCardStyle}" Width="370" Margin="12" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="FindBox" Style="{StaticResource AddressTextBoxStyle}" Height="30" Margin="6,0,6,0"
                             KeyDown="FindBox_KeyDown" />
                    <Button Grid.Column="1" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74A;" Click="FindPrevious_Click" ToolTip="Предыдущее" />
                    <Button Grid.Column="2" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74B;" Click="FindNext_Click" ToolTip="Следующее" />
                    <Button Grid.Column="3" Style="{StaticResource PanelCloseButtonStyle}" Content="&#xE8BB;" Click="CloseFind_Click" ToolTip="Закрыть" />
                </Grid>
            </Border>
        </Popup>

        <!-- Уведомление -->
        <Popup x:Name="ToastPopup" PlacementTarget="{Binding ElementName=ContentHost}" Placement="Relative"
               AllowsTransparency="True" PopupAnimation="Fade" IsHitTestVisible="False">
            <Border Background="#202A3C" CornerRadius="9" Padding="14,9" Margin="12">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="12.5" />
            </Border>
        </Popup>
    </Grid>
</Window>
