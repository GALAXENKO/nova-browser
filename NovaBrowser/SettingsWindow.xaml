<Window x:Class="NovaBrowser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Nova Browser" Width="730" Height="720" MinHeight="620"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4E6BFF" Offset="0" />
                            <GradientStop Color="#8B5CF6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="N" Foreground="White" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Настройки" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource WindowButtonStyle}" Width="46" Height="42"
                    Content="&#xE8BB;" Click="Cancel_Click" ToolTip="Закрыть" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,22,26,8">
            <StackPanel>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Поиск и стартовая страница" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <TextBlock Text="Поисковая система" Style="{StaticResource SettingsLabelStyle}" />
                        <ComboBox x:Name="SearchEngineCombo" Style="{StaticResource SettingsComboBoxStyle}" />

                        <TextBlock Text="Домашняя страница" Style="{StaticResource SettingsLabelStyle}" Margin="0,17,0,6" />
                        <TextBox x:Name="HomePageBox" Style="{StaticResource SettingsTextBoxStyle}" />
                        <TextBlock Text="Оставьте поле пустым, чтобы открывать стартовую страницу Nova."
                                   Style="{StaticResource SettingsHintStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Внешний вид" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox x:Name="ShowBookmarksCheck" Style="{StaticResource SettingsCheckBoxStyle}"
                                  Content="Показывать панель закладок под адресной строкой" />
                        <TextBlock Text="Панель можно скрыть в любой момент, нажав Ctrl+Shift+B."
                                   Style="{StaticResource SettingsHintStyle}" Margin="24,5,0,0" />
                        <CheckBox x:Name="DarkThemeCheck" Style="{StaticResource SettingsCheckBoxStyle}"
                                  Content="Тёмная тема оформления" Margin="0,14,0,0" />
                        <TextBlock Text="Тёмное оформление применяется сразу после сохранения."
                                   Style="{StaticResource SettingsHintStyle}" Margin="24,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Запуск и загрузки" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox x:Name="RestoreSessionCheck" Style="{StaticResource SettingsCheckBoxStyle}"
                                  Content="Восстанавливать вкладки после перезапуска" />

                        <TextBlock Text="Папка для загрузок" Style="{StaticResource SettingsLabelStyle}" Margin="0,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DownloadsFolderBox" Style="{StaticResource SettingsTextBoxStyle}" />
                            <Button Grid.Column="1" Style="{StaticResource SoftButtonStyle}" Content="Обзор…"
                                    Height="36" Margin="8,0,0,0" Click="BrowseDownloads_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Данные браузера" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="История, закладки и настройки хранятся только на этом компьютере."
                                   Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SoftButtonStyle}" Content="Очистить историю" Click="ClearHistory_Click" />
                            <Button Style="{StaticResource SoftButtonStyle}" Content="Сбросить настройки" Click="Reset_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Nova Browser 1.0.0 · Chromium WebView2" FontSize="10.5"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,12" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="26,0">
                <TextBlock Text="Изменения применяются сразу после сохранения" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SoftButtonStyle}" Content="Отмена" Width="96" Click="Cancel_Click" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Сохранить" Width="108" Margin="9,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
